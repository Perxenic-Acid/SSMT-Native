{
  "schemaVersion": 1,
  "id": "ssmt.hoyoshade.bridge",
  "name": "HoYoShade Bridge",
  "version": "0.1.1",
  "author": "SSMT",
  "compatibility": {
    "ssmt": ">=4.x",
    "platforms": [
      "windows-x64"
    ],
    "games": [
      "GIMI",
      "SRMI",
      "ZZMI",
      "ZZMIDX12",
      "HIMI"
    ]
  },
  "contributions": {
    "runtimePlugins": [],
    "launcherAdapters": [
      {
        "type": "process-forwarder",
        "executable": "${external.hoyoshade}/inject.exe",
        "arguments": [
          "${game.processName}"
        ],
        "workingDirectory": "${external.hoyoshade}",
        "ready": {
          "type": "process-exited",
          "timeoutMs": 15000
        },
        "failurePolicy": "abort"
      }
    ],
    "uiPages": [
      {
        "id": "settings",
        "route": "/plugins/hoyoshade",
        "path": "ui/hoyoshade-settings"
      }
    ],
    "hostExtensions": [
      {
        "id": "graphics",
        "provider": "ssmt.graphics.reshade",
        "priority": 10,
        "settingsComponent": "ssmt.reshade.settings",
        "config": "host/graphics.json"
      }
    ]
  },
  "externalDependencies": [
    {
      "id": "hoyoshade",
      "type": "directory",
      "downloadUrl": "https://github.com/DuolaD/HoYoShade/releases",
      "downloadHint": "下载并解压 HoYoShade，按发布说明补齐效果库，再选择包含所列文件的目录。",
      "requiredFiles": [
        "inject.exe",
        "ReShade64.dll",
        "ReShade.ini",
        "LauncherResource/INIBuild.exe",
        "InjectResource",
        "reshade-shaders",
        "Presets"
      ]
    }
  ],
  "permissions": [
    "process.spawn",
    "process.observe",
    "game.launch",
    "filesystem.read",
    "filesystem.write",
    "native.inject"
  ]
}
