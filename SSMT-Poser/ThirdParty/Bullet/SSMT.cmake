# 只编译 Bullet 3.25 的 CPU 刚体核心，保留上游源码，不构建演示、GPU、Python 或软体模块。
set(SSMT_BULLET_ROOT "${CMAKE_CURRENT_LIST_DIR}")
foreach(module LinearMath BulletCollision BulletDynamics)
    file(GLOB_RECURSE module_sources CONFIGURE_DEPENDS "${SSMT_BULLET_ROOT}/src/${module}/*.cpp")
    if(module STREQUAL "LinearMath")
        list(FILTER module_sources EXCLUDE REGEX "/TaskScheduler/")
    endif()
    add_library(PoserBullet${module} STATIC ${module_sources})
    target_include_directories(PoserBullet${module} SYSTEM PUBLIC "${SSMT_BULLET_ROOT}/src")
    target_compile_definitions(PoserBullet${module} PRIVATE WIN32_LEAN_AND_MEAN NOMINMAX)
    target_compile_options(PoserBullet${module} PRIVATE /utf-8 /W0 /MP)
endforeach()
target_link_libraries(PoserBulletBulletCollision PUBLIC PoserBulletLinearMath)
target_link_libraries(PoserBulletBulletDynamics PUBLIC PoserBulletBulletCollision)
