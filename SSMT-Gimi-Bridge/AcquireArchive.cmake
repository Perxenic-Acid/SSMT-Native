include_guard(GLOBAL)

# 仅发布校验通过的完整归档；构建目录之间共享缓存，不共享打过补丁的源码。
function(ssmt_acquire_bridge_archive output archive url expected_hash)
    cmake_parse_arguments(INPUT "" "LOCAL_ARCHIVE" "CANDIDATES" ${ARGN})
    if(INPUT_LOCAL_ARCHIVE)
        if(NOT EXISTS "${INPUT_LOCAL_ARCHIVE}" OR IS_DIRECTORY "${INPUT_LOCAL_ARCHIVE}")
            message(FATAL_ERROR "Bridge 离线归档不存在：${INPUT_LOCAL_ARCHIVE}")
        endif()
        file(SHA256 "${INPUT_LOCAL_ARCHIVE}" actual_hash)
        if(NOT actual_hash STREQUAL expected_hash)
            message(FATAL_ERROR "Bridge 离线归档 SHA-256 不匹配：${INPUT_LOCAL_ARCHIVE}\n预期：${expected_hash}\n实际：${actual_hash}")
        endif()
        set(${output} "${INPUT_LOCAL_ARCHIVE}" PARENT_SCOPE)
        return()
    endif()

    get_filename_component(cache_dir "${archive}" DIRECTORY)
    file(MAKE_DIRECTORY "${cache_dir}")
    # 同一源码的并行配置不能覆盖对方的下载；每次持锁后重新核验缓存。
    file(LOCK "${archive}.lock" GUARD FUNCTION TIMEOUT 15 RESULT_VARIABLE lock_result)
    if(NOT lock_result STREQUAL "0")
        message(FATAL_ERROR "Bridge 下载缓存正在使用或不可写：${archive}\n${lock_result}")
    endif()
    string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
    set(partial "${archive}.${nonce}.part")
    set(ready FALSE)
    foreach(candidate IN ITEMS "${archive}" ${INPUT_CANDIDATES})
        if(NOT EXISTS "${candidate}" OR IS_DIRECTORY "${candidate}")
            continue()
        endif()
        file(SHA256 "${candidate}" actual_hash)
        if(NOT actual_hash STREQUAL expected_hash)
            message(STATUS "忽略不完整或哈希不符的 Bridge 缓存：${candidate}")
            continue()
        endif()
        if(candidate STREQUAL archive)
            message(STATUS "复用已校验 Bridge 缓存：${archive}")
            set(${output} "${archive}" PARENT_SCOPE)
            return()
        endif()
        file(COPY_FILE "${candidate}" "${partial}" RESULT copy_result)
        if(NOT copy_result STREQUAL "0")
            file(REMOVE "${partial}")
            message(FATAL_ERROR "Bridge 缓存复制失败：${copy_result}")
        endif()
        file(SHA256 "${partial}" copied_hash)
        if(copied_hash STREQUAL expected_hash)
            message(STATUS "复用旧构建的 Bridge 归档：${candidate}")
            set(ready TRUE)
            break()
        endif()
        file(REMOVE "${partial}")
    endforeach()

    if(NOT ready)
        foreach(attempt RANGE 1 3)
            message(STATUS "下载 Bridge 固定源码（${attempt}/3）：${url}")
            # EXPECTED_HASH 会在网络错误时直接标记配置失败，无法可靠重试；先检查状态再验哈希。
            file(DOWNLOAD "${url}" "${partial}" TLS_VERIFY ON TIMEOUT 120
                INACTIVITY_TIMEOUT 30 STATUS download_status)
            list(GET download_status 0 download_code)
            list(GET download_status 1 last_error)
            if(download_code EQUAL 0)
                file(SHA256 "${partial}" actual_hash)
                if(actual_hash STREQUAL expected_hash)
                    set(ready TRUE)
                    break()
                endif()
                set(last_error "SHA-256 不匹配，预期 ${expected_hash}，实际 ${actual_hash}")
            endif()
            file(REMOVE "${partial}")
            message(STATUS "Bridge 下载未完成：${last_error}")
            if(attempt LESS 3)
                execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 2)
            endif()
        endforeach()
    endif()
    if(NOT ready)
        message(FATAL_ERROR "Bridge 源码下载失败，已停止配置，不会解压半包。\n${url}\n${last_error}\n可通过 -DSSMT_GIMI_BRIDGE_ARCHIVE=<完整 ZIP 路径> 提供同版本离线归档；仍须通过固定 SHA-256 校验。")
    endif()
    file(RENAME "${partial}" "${archive}" RESULT publish_result)
    if(NOT publish_result STREQUAL "0")
        file(REMOVE "${partial}")
        message(FATAL_ERROR "Bridge 完整缓存保存失败：${publish_result}")
    endif()
    set(${output} "${archive}" PARENT_SCOPE)
endfunction()
